# Bundled parser metadata for the IntentumDiff language-info API.
# Plugin code exposes this data; the host still owns trust and provenance.

[plugin]
author = IntentumDiff
plugin_version = 0.1.0
last_updated = 2026-05-19

[language.dax]
language_name = DAX
language_short_name = DAX
monaco_language = plaintext
default_filename = measure.dax
